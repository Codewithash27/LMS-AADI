# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Database (required)
# If password has @, encode it as %40 in DATABASE_URL
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/lms_db
PGDATABASE=lms_db
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=YOUR_PASSWORD

# Session (required)
SESSION_SECRET=change-this-to-a-long-random-string

# Server
NODE_ENV=development
PORT=5000

# Together AI (optional — needed for AI chat features)
TOGETHER_API_KEYS=
TOGETHER_API_KEY=
